{
  "$id": "https://kashitaxi.in/schema/ganga-mahotsav-lineup.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ganga Mahotsav Lineup Schema",
  "type": "object",
  "required": ["festival", "days"],
  "properties": {
    "festival": {
      "type": "object",
      "required": ["id", "name_hi", "name_en", "location", "dates", "status"],
      "properties": {
        "id": {"type": "string"},
        "name_hi": {"type": "string"},
        "name_en": {"type": "string"},
        "timezone": {"type": "string"},
        "status": {"type": "string", "enum": ["provisional", "confirmed", "updated"]},
        "lastUpdated": {"type": "string", "format": "date"},
        "location": {
          "type": "object",
            "required": ["venue", "city", "country"],
            "properties": {
              "venue": {"type": "string"},
              "city": {"type": "string"},
              "state": {"type": "string"},
              "country": {"type": "string"},
              "geo": {
                "type": "object",
                "properties": {
                  "lat": {"type": "number"},
                  "lng": {"type": "number"}
                }
              }
            }
        },
        "dates": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"},
            "days": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "meta": {"type": "object"},
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "label", "slots"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "label": {"type": "string"},
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end", "segment"],
              "properties": {
                "start": {"type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"},
                "end": {"type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"},
                "segment": {"type": "string"},
                "artistPlaceholderId": {"type": "string"},
                "provisional": {"type": "boolean"},
                "genre": {"type": "array", "items": {"type": "string"}},
                "set": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "schema": {"type": "object"}
  }
}
