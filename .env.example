# Google Places API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Places API (New) in your Google Cloud project
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Example:
# GOOGLE_PLACES_API_KEY=AIzaSyBvOkBa6yLlJIXNhHDx123456789012345

# Email Configuration for Contact Form API
# Get these credentials from your email provider

# SMTP Settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Notification Email (where booking requests will be sent)
NOTIFICATION_EMAIL=bookings@kashitaxi.in

# For Gmail:
# 1. Go to Google Account settings
# 2. Security → 2-Step Verification (enable it)
# 3. App passwords → Generate new app password
# 4. Use that 16-character password as SMTP_PASSWORD

# For other email providers:
# - Update SMTP_HOST and SMTP_PORT accordingly
# - Outlook: smtp-mail.outlook.com:587
# - Yahoo: smtp.mail.yahoo.com:465
# - SendGrid: smtp.sendgrid.net:587 (recommended for production)
