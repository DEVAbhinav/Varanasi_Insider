# WhatsApp AI Chat Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# WhatsApp Business API Configuration
# ============================================
# Provider: Meta Cloud API / 360dialog / Twilio
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# AI Provider Configuration - Agent Assist Mode
# ============================================
# Dual LLM Support: Gemini (fast) + GPT (complex)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# LLM Selection
PRIMARY_LLM=gemini-3-flash
FALLBACK_LLM=gpt-5.2
LLM_TIMEOUT_MS=30000
MAX_CONTEXT_TOKENS=8000

# Generation Settings
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500

# Response Caching (reduces API costs)
ENABLE_RESPONSE_CACHE=true
RESPONSE_CACHE_TTL_HOURS=24

# Knowledge Base for Context Injection
KNOWLEDGE_BASE_PATH=./data/knowledge_base.json


# ============================================
# Knowledge Base Configuration
# ============================================
KB_PATH=./data
KB_SERVICES_FILE=services.json
KB_PACKAGES_FILE=packages.json
KB_PRICING_FILE=pricing.json
KB_ROUTES_FILE=routes.json
KB_FAQS_FILE=faqs.json
KB_FESTIVALS_FILE=festivals.json
KB_UPDATE_INTERVAL=3600

# ============================================
# Business Information
# ============================================
BUSINESS_NAME=Kashi Taxi
BUSINESS_WEBSITE=https://www.kashitaxi.in
BUSINESS_PHONE_PRIMARY=+919450301573
BUSINESS_PHONE_GROUP=+919935474730
BUSINESS_EMAIL=bookings@kashitaxi.in
ESCALATION_PHONE=+919450301573

# ============================================
# Language Configuration
# ============================================
DEFAULT_LANGUAGE=hi
SUPPORTED_LANGUAGES=hi,en

# ============================================
# Session & Conversation Settings
# ============================================
SESSION_TTL_HOURS=3
CONVERSATION_LOG_DAYS=90
MAX_MESSAGES_PER_SESSION=100

# ============================================
# Feature Flags
# ============================================
FEATURE_UPSELL_ENABLED=true
FEATURE_PAYMENT_LINKS=true
FEATURE_HUMAN_ESCALATION=true
FEATURE_ANALYTICS=true

# ============================================
# PWA Configuration
# ============================================
PWA_ENABLED=true
PWA_APP_NAME=Kashi Taxi Assistant Admin
PWA_SHORT_NAME=KT Admin
PWA_THEME_COLOR=#25d366
PWA_BG_COLOR=#1a1a2e

# ============================================
# Push Notifications (PWA)
# ============================================
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
PUSH_CONTACT_EMAIL=admin@kashitaxi.in

# ============================================
# Cache Settings (PWA)
# ============================================
CACHE_VERSION=v1
CACHE_MAX_AGE_STATIC=86400
CACHE_MAX_AGE_API=300

# ============================================
# Logging & Monitoring
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=your_sentry_dsn

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS_PER_MIN=100
RATE_LIMIT_BURST=20

# ============================================
# Database (Future)
# ============================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/kt_assistant
# REDIS_URL=redis://localhost:6379

# ============================================
# Deployment (DO NOT USE IN PRODUCTION)
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost
