        {
          "@type": "Question",
          "name": "How far is Sarnath from Varanasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sarnath is just 10 km from Varanasi city center (20-30 minutes drive). Half-day tour of 5-6 hours is perfect for covering all sites."
          }
