          "@type": "Question",
          "name": "What is covered in Sarnath Tempo Traveller tour?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dhamek Stupa, Mulagandha Kuti Vihara, Sarnath Museum (Ashoka Pillar), Chaukhandi Stupa, Thai/Japanese/Chinese monasteries, and vegetarian lunch stop."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide licensed guides at Sarnath?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, ASI-licensed English and Hindi-speaking guides available at ₹500-800 extra. Recommended for understanding Buddhist history and significance."
