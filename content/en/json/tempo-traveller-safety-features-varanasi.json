      "@id": "https://www.kashitaxi.in/en/tempo-traveller-safety-features-varanasi#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do we verify a Tempo Traveller is safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Inspect tyre tread, emergency exit clearance, fire extinguisher, seating integrity, recent service note."
          }
        },
        {
          "@type": "Question",
          "name": "Is night highway driving allowed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Restricted to dusk arrivals; prolonged post‑10 PM highway push discouraged to mitigate fatigue risk."
          }
        },
        {
          "@type": "Question",
          "name": "Do drivers rotate on long multi-day circuits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For >6 consecutive long days or >1,600 km overall, rotation or enforced rest introduced."
          }
        },
        {
          "@type": "Question",
          "name": "What emergency items should be aboard?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Basic first-aid kit, water reserve, torch, reflective triangle, functional fire extinguisher."
          }
        },
        {
          "@type": "Question",
          "name": "How to reduce motion fatigue for seniors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Seat seniors front half, schedule hydration, maintain ventilation, cap drive blocks <2.5 hrs."
          }
        }
      ]
