        {
          "@type": "Question",
          "name": "What is the ideal order for Kashi Gaya Prayag Pind Daan tour?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Typical: Kashi prelim → Gaya Pind Daan → Prayagraj Sangam tarpan. Order can shift based on priest slot availability."
          }
        },
        {
          "@type": "Question",
          "name": "How many days are required for the circuit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tight 3D/2N possible; balanced & elder friendly 4D/3N preferred."
          }
        },
        {
          "@type": "Question",
          "name": "Do we need to pre-book a panda in Gaya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes in peak Pitru Paksha / Amavasya. Pre-agree dakshina & language."
          }
        },
        {
          "@type": "Question",
          "name": "Can women perform pind daan as karta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes—many priests facilitate when family custom allows or male heir absent."
          }
        },
        {
          "@type": "Question",
          "name": "Best Tempo Traveller size for elders & ritual items?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Up to 8 pax → 9 seater; 9–11 with elders → 12 seater; 12–16 + vessels → 17 seater."
          }
        }
