        {
          "@type": "Question",
          "name": "What is the outstation cab rate from Varanasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ertiga ₹12-14/km, Innova Crysta ₹16-18/km, 12 Seater Tempo ₹24/km, 17 Seater Tempo ₹27/km, Force Urbania ₹34-35/km. Minimum 250 km/day. Driver allowance ₹400-800/night extra."
          }
        },
        {
          "@type": "Question",
          "name": "Can I choose 6 or 7 seats in Innova?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We log your preference (captain seats vs bench) during booking based on availability."
          }
        },
        {
          "@type": "Question",
          "name": "How do you count distance—garage to garage or pickup to drop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Industry standard is garage-to-garage; your quote will show the assumed start/return point."
          }
        },
        {
          "@type": "Question",
          "name": "Can I add a luggage carrier for Innova/Ertiga/SUV?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, request outstation cab with luggage carrier Varanasi while booking so we arrange the right rack and rain cover."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide GST bills?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes—WhatsApp estimate, trip sheet, and GST invoice on eligible bookings."
          }
        }
