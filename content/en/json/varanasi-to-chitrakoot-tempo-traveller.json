      "@type": "FAQPage",
      "@id": "https://www.kashitaxi.in/en/varanasi-to-chitrakoot-tempo-traveller#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the distance from Varanasi to Chitrakoot by road?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Varanasi to Chitrakoot distance is roughly 270–285 km via Prayagraj (NH19 + NH35) taking 6–7 hours with two stops."
          }
        },
        {
          "@type": "Question",
          "name": "Is Chitrakoot doable as a same-day trip from Varanasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Possible but not advised. A 1N/2D plan allows Kamadgiri Parikrama, evening/morning Ramghat and core sites without fatigue."
          }
        },
        {
          "@type": "Question",
          "name": "What is covered in a 2 day Chitrakoot itinerary?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Day 1: Drive, Ramghat, Aarti, Kamadgiri (or morning Day 2). Day 2: Hanuman Dhara, Sphatik Shila, Bharat Milap, Gupt Godavari Caves then return."
          }
        },
        {
          "@type": "Question",
          "name": "Best Tempo Traveller size for Chitrakoot pilgrimage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Up to 8 pax light luggage → 9 seater; 9–11 or elders → 12 seater; 12–16 or multi‑family → 17 seater."
          }
        },
        {
          "@type": "Question",
          "name": "What is the indicative 2 day cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "12 seater: ~600–630 km @ ₹24/km + driver allowance + toll/parking ≈ ₹15,900–₹16,500 (non-luxury)."
          }
        }
      ]
