        {
          "@type": "Question",
          "name": "Is 3 days enough for the Prayagraj Ayodhya Chitrakoot circuit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes for core darshan; add a 4th day for deeper Ram Katha sittings & broader Chitrakoot coverage."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best sequence order?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prayagraj → Ayodhya → Chitrakoot minimizes backtracking; reverse only for Ayodhya event constraints."
          }
        },
        {
          "@type": "Question",
          "name": "Which vehicle size for 11 pilgrims?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "12 seater for aisle comfort; upgrade to 17 seater if elderly travellers + larger bags present."
          }
        },
        {
          "@type": "Question",
          "name": "How to mitigate peak crowd?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dawn Sangam immersion, early Ayodhya entry, mid‑morning Chitrakoot ghats, disciplined pre‑dawn departures."
          }
        },
        {
          "@type": "Question",
          "name": "Is night driving required?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No with proper starts; only dusk arrivals if darshan windows slip."
