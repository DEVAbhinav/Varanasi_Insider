      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is the Dashashwamedh Ganga Aarti safe for solo female travellers at night?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "High police visibility and continuous public presence. Use main lanes post-ceremony and pre-arrange pick-up at Godowlia."
          }
        },
        {
          "@type": "Question",
          "name": "What time do police barricades go up at Dashashwamedh Ghat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Soft channeling starts ~45 minutes prior; tighter cordons 25–30 minutes before start on high season / festival days."
          }
        },
        {
          "@type": "Question",
          "name": "Can I fly a drone during the Ganga Aarti?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generally no. Festival windows see explicit drone bans. Unauthorized flights risk confiscation."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a ticket to watch the Aarti?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Steps are free. Paid elements: front chairs (₹200–₹350), reserved galleries (festival), and boats (separate fares)."
          }
        },
        {
          "@type": "Question",
          "name": "Why are timings online sometimes different by 15 minutes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Seasonal sunset shifts plus buffer; effective lamp ignition can vary ±5–10 mins with crowd control adjustments."
          }
        }
