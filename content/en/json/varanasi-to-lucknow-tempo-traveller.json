          "@type": "Question",
          "name": "What is the fare for a Varanasi to Lucknow Tempo Traveller?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 12 seater is billed at ₹23/km (minimum 340 km) with typical fixed quotes of ₹12,500–₹13,500; 17 seaters are ₹26/km."
          }
        },
        {
          "@type": "Question",
          "name": "How long is the drive from Varanasi to Lucknow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The 320 km run via Purvanchal Expressway takes 5.5–6 hours including one meal halt, with minor toll queues on weekends."
          }
        },
        {
          "@type": "Question",
          "name": "Can we get on-board Wi-Fi and charging points?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Premium Travellers provide 4G Wi-Fi dongles, fast USB charging, and laptop trays suitable for corporate travellers."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide night driving for airport pickups?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "24×7 operations are supported, with ₹600 night allowance after 11 PM and optional two-driver rotations for red-eye runs."
