      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the Kashi Darshan Tempo Traveller price?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "9 Seater at ₹4,500, 12 Seater at ₹5,500, and 17 Seater at ₹7,500 for 8 hours/80 km package. Driver batta, fuel, and parking included."
          }
        },
        {
          "@type": "Question",
          "name": "Which temples are covered in Kashi Darshan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kashi Vishwanath Temple, Sankat Mochan Hanuman Temple, Durga Temple (Monkey Temple), Tulsi Manas Mandir, New Vishwanath Temple at BHU, and Bharat Mata Temple."
          }
        },
        {
          "@type": "Question",
          "name": "How long is Kashi Darshan by Tempo Traveller?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard package is 8 hours with 80 km limit. Starts from hotel pickup, covers 6-8 temples, and returns to hotel. Extra hours at ₹500/hr."
          }
        },
        {
          "@type": "Question",
          "name": "Is Ganga Aarti included in Kashi Darshan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Evening Ganga Aarti at Dashashwamedh Ghat can be included. Request morning start (6 AM) or evening end (8 PM) to accommodate Aarti timing."
          }
        }
      ]
