      "@id": "https://www.kashitaxi.in/en/tempo-traveller-booking-guide-varanasi#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How far in advance should we book a Tempo Traveller in Varanasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Peak pilgrimage & winter weekends: 10–15 days; shoulder weekdays: 4–6 days; festival windows earlier preferred."
          }
        },
        {
          "@type": "Question",
          "name": "What is a normal advance amount?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "20–30% of projected hire; higher only for multi-state blocks or last-minute peak locking."
          }
        },
        {
          "@type": "Question",
          "name": "Do we get written confirmation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes—request a summary with dates, vehicle type, km rate, inclusions, driver allowance, escalation contact."
          }
        },
        {
          "@type": "Question",
          "name": "When do cancellation fees apply?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": ">7 days: mostly refundable minus admin; 3–7 days: partial; <48 hrs: advance often retained."
          }
        },
        {
          "@type": "Question",
          "name": "How to avoid fraud or broker padding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Verify GST / business registration, request vehicle RC last digits, insist on traceable payment receipts."
          }
        }
      ]
    },
