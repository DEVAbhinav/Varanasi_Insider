        },
        {
          "@type": "Question",
          "name": "Is same-day Varanasi to Kushinagar return possible?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not recommended—14+ hours driving is exhausting and reduces pilgrimage quality. Overnight stay recommended for meditation at Mahaparinirvana Temple."
          }
        },
        {
          "@type": "Question",
          "name": "Which vehicle for 10-12 Buddhist pilgrims?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "12 seater for comfort with aisle space. 17 seater if >11 pax or bulky luggage. Urbania for senior pilgrims needing premium comfort."
          }
        },
