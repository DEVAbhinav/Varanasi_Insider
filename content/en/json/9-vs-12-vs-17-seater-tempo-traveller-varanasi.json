      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which is better for Ayodhya from Varanasi – 9, 12 or 17 seater?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For Ayodhya (420–460 km RT) 12 seater is ideal up to 11 pax; upgrade to 17 if elders, heavy luggage or 12+ passengers."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 9 seater comfortable for long day trips?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Comfortable for 7–8 with light luggage up to ~5 hrs. For longer (Bodh Gaya 12–14 hr) consider 12/17 seater."
          }
        },
        {
          "@type": "Question",
          "name": "When does 17 seater per‑head cost justify upgrade?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At 11–13 passengers per‑head gap vs 12 narrows; added aisle & luggage ease justifies upgrade."
          }
        },
        {
          "@type": "Question",
          "name": "Do all sizes include AC & pushback seats?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Recliner 1×1 only on Urbania / Maharaja luxury variants."
          }
        },
        {
          "@type": "Question",
          "name": "Can roof carrier be added last minute?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually yes with 12–24h notice; we pre-fit for wedding / airport cluster / pind daan luggage days."
          }
        }
      ]
