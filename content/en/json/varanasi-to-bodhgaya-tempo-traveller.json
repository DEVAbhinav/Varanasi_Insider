        {
          "@type": "Question",
          "name": "What is the distance from Varanasi to Bodhgaya by tempo traveller?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Varanasi to Bodhgaya is 262 km by road. A tempo traveller takes 5-6 hours via NH19 (Varanasi → Mohania → Gaya → Bodhgaya)."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a tempo traveller cost from Varanasi to Bodhgaya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "12-seater starts from ₹12,314 one-way and ₹14,148 same-day return. 17-seater is ₹16,244 return, 26-seater is ₹18,340, and Force Urbania is ₹19,388. Includes vehicle, driver, fuel, and NH19 tolls."
          }
        },
        {
          "@type": "Question",
          "name": "Can we do Gaya Pind Daan and Bodhgaya in one day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Leave Varanasi at 4 AM, reach Gaya by 9:30 AM for Vishnupad Pind Daan, then Bodhgaya (13 km) for Mahabodhi Temple. Return by 11 PM."
          }
        }
      ]
