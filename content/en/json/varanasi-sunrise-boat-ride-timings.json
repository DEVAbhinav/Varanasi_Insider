        "mainEntity": [
          {
            "@type": "Question",
            "name": "When should I board for a sunrise boat ride in peak winter vs summer?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Board 35–40 min before sunrise in winter (fog slows positioning) and 25–30 min before in summer (clear visibility)."
            }
          },
          {
            "@type": "Question",
            "name": "What if monsoon water levels are high?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "High river stages can suspend boating; confirm locally the evening before. If suspended, attend Subah-e-Banaras from the ghat instead."
            }
          },
          {
            "@type": "Question",
            "name": "Is pre-booking necessary for sunrise?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Not usually outside peak October–November festivals. For photography-focused private boats, pre-book the evening prior."
            }
          }
