          "@type": "Question",
          "name": "What is the distance from Varanasi to Naimisharanya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Approx 390–410 km one way depending on chosen route variant via Lucknow / Sitapur."
          }
        },
        {
          "@type": "Question",
          "name": "Is a same-day Varanasi to Naimisharanya trip realistic?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not recommended; total 780–820 km could exceed 16 hours. 1N/2D gives depth and safety."
          }
        },
        {
          "@type": "Question",
          "name": "Key sacred sites in Naimisharanya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Chakratirth, Lalita Devi Temple, Dadhichi Kund, Sukadeva / Vyasa Gaddi, Hanuman Garhi, Sita Kund, Chakra Sthal, optional Pandav Qila."
          }
        },
        {
          "@type": "Question",
          "name": "Best time to start from Varanasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "4:30–5:00 AM ensures afternoon darshan sequence and reduced mid‑day fatigue."
