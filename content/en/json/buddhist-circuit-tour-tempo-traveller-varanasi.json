        {
          "@type": "Question",
          "name": "How many days for a core Buddhist circuit from Varanasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Core fast-track: 5 Days (Sarnath, Bodh Gaya, Rajgir/Nalanda, Kushinagar). With Lumbini: 7–8 Days."
          }
        },
        {
          "@type": "Question",
          "name": "What vehicle size fits 10–12 pilgrims with cushions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "12 seater offers aisle + cushion storage. Upgrade to 17 seater if >11 or bulky gear."
          }
        },
        {
          "@type": "Question",
          "name": "Can Lumbini be added to a 5 day plan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not recommended; extend to 7–8 days to prevent fatigue and rushed meditations."
          }
        },
        {
          "@type": "Question",
          "name": "Do we need permits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Indian citizens: no special permit. Carry passport/Aadhaar for Nepal border (Lumbini)."
          }
        },
        {
          "@type": "Question",
          "name": "Is night driving needed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Well-planned pacing avoids night highway runs; only dusk arrivals if departure slips."
          }
        }
      ]
