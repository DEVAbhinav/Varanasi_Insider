          "@type": "Question",
          "name": "How do you manage multi-hotel corporate airport pickups in Varanasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We cluster manifests by arrival time, assign order, share driver details 12–18h prior and create a dispatcher WhatsApp group for live ETAs."
          }
        },
        {
          "@type": "Question",
          "name": "Can you provide GST invoice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. GST-compliant invoice issued—provide GSTIN and entity name at confirmation."
          }
        },
        {
          "@type": "Question",
          "name": "Do you support schedule changes during conferences?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes—dispatcher evaluates slack and reissues updated timetable to all drivers."
          }
        },
        {
          "@type": "Question",
          "name": "Best seating size for 14 delegates with kits?",
          "acceptedAnswer": {
            "@type": "Answer",
