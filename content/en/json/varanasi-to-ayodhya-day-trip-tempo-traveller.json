        {
          "@type": "Question",
          "name": "What is the price of a Tempo Traveller day trip to Ayodhya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "₹14,500 for a 12 seater all-inclusive package covering vehicle, driver, tolls, and parking. 17 seaters cost ₹15,500."
