      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can Ayodhya be covered comfortably in a single day from Varanasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. With a 4:30–5:00 AM start you can complete Ram Mandir darshan, Hanuman Garhi, Kanak Bhawan, and Saryu Aarti before returning to Varanasi by 9:00 PM."
          }
        },
        {
          "@type": "Question",
          "name": "What is the price of a Tempo Traveller day trip to Ayodhya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "12-seater Tempo Traveller starts from ₹9,400 one-way and ₹10,800 for a same-day round trip. 17-seater is ₹10,200 one-way (₹12,400 round-trip), 26-seater is ₹11,600 (₹14,000 return), and Force Urbania is ₹13,000 (₹14,800 return) including AC vehicle, driver, tolls, and parking."
          }
        },
        {
          "@type": "Question",
          "name": "Do you include meal stops in the day plan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Breakfast near Handia, lunch at trusted Ayodhya restaurants, and a tea break on the return leg are scheduled, with special diets arranged on request."
          }
        },
        {
          "@type": "Question",
          "name": "How do you manage senior citizens on this long day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rest intervals every 90 minutes, travel pillows, wheelchair support at Ram Mandir, and elevator access coordination keep seniors comfortable."
          }
        }
      ]
