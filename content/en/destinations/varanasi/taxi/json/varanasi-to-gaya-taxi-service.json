        {
          "@type": "Question",
          "name": "How long does Varanasi to Gaya take by taxi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "260 km distance takes 5 hours 40 minutes via NH-19 and NH-120. With one rest stop, expect 6-6.5 hours total travel time."
          }
        },
        {
          "@type": "Question",
          "name": "What's included in the taxi fare?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Driver, fuel, AC, tolls (₹350-450), insurance, vehicle maintenance. NOT included: meals, optional parking, driver tip."
          }
        },
        {
          "@type": "Question",
          "name": "Can I stop at Bodhgaya instead of Gaya city?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Bodhgaya is 25 km from Gaya station. Update destination at booking. Cost increases ₹500-800."
          }
        },
        {
          "@type": "Question",
          "name": "Can we take breaks in between?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Tell driver where to stop. Highway dhabas are reliable. Stops add 30-60 minutes to total time."
          }
        },
        {
          "@type": "Question",
          "name": "What if the driver cancels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide alternative vehicle immediately (same or better quality) or full refund. No acceptable driver cancellations."
          }
        },
        {
          "@type": "Question",
          "name": "Can we book for 8+ people?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Tempo Traveller (12-17 seater). Quote will be for full vehicle at ₹22,000-26,000 total."
          }
        }
