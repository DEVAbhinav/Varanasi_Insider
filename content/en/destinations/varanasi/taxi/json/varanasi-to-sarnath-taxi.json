      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I do a Sarnath day trip from Varanasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, 4-5 hour visits are perfect. You can easily visit Sarnath and return to Varanasi the same day."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a guide for Sarnath?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, the site is self-explanatory. However, a guide adds depth to your experience for ₹500-800."
          }
        },
        {
          "@type": "Question",
          "name": "What if I'm not Buddhist, should I still visit Sarnath?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely! It's historically fascinating and spiritually interesting regardless of religion."
          }
        },
        {
          "@type": "Question",
          "name": "What is the distance from Varanasi to Sarnath?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sarnath is approximately 60 kilometers from Varanasi city center, taking about 90 minutes by taxi in normal traffic."
          }
        },
        {
          "@type": "Question",
          "name": "How much does Varanasi to Sarnath taxi cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One-way taxi costs ₹1,200-1,500. Return trip with waiting is ₹2,000-2,500. Full-day experience with guide is ₹2,500-3,000."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best time to visit Sarnath?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Early morning (6:30 AM - 9 AM) is best for peaceful experience with minimal crowds and excellent photography light. Avoid 10 AM - 3 PM due to heat and crowds."
          }
        }
      ]
