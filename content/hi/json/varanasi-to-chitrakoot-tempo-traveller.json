      "mainEntity": [
        {
          "@type": "Question",
          "name": "वाराणसी से चित्रकूट की दूरी कितनी है?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "लगभग 270–285 किमी (NH19 + NH35) – दो पड़ावों के साथ 6–7 घंटे।"
          }
        },
        {
          "@type": "Question",
          "name": "क्या एक ही दिन में चित्रकूट यात्रा संभव है?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "तकनीकी रूप से संभव पर थकाऊ। 1N/2D योजना में कामदगिरि, रामघाट सुबह-शाम आराम से देख सकते हैं।"
          }
        },
        {
          "@type": "Question",
          "name": "दो दिन के itinerary में क्या शामिल है?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "दिन 1: ड्राइव, रामघाट, आरती, कामदगिरि। दिन 2: हनुमान धारा, भारत मिलाप, स्फटिक शिला, गुप्त गोदावरी और वापसी।"
          }
        },
        {
          "@type": "Question",
          "name": "कौन सा टेम्पो ट्रैवलर आकार उपयुक्त है?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "8 तक → 9-सीटर, 9–11 या वरिष्ठ → 12-सीटर, 12–16 → 17-सीटर।"
          }
        },
        {
          "@type": "Question",
          "name": "कुल लागत कितनी आती है?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "12-सीटर संदर्भ: ~600–630 किमी @ ₹24/किमी + ड्राइवर भत्ता + टोल/पार्किंग ≈ ₹16,000।"
          }
        }
      ]
